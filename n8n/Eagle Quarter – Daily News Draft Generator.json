        "jsCode": "const today = new Date().toISOString().split('T')[0];\n\nconst markdown = `---\ntitle: \"${$json.title}\"\ndescription: \"Independent summary of recent developments relating to Eagle Quarter in Newbury.\"\npubDate: ${today}\ntags: [\"eagle quarter\", \"newbury\", \"regeneration\"]\ndraft: true\n---\n\n${$json.text}`;\n\nreturn [{\n  content: markdown,\n  filename: $json.filename\n}];"

      "parameters": {
        "jsCode": "const slug = $json.title\n  .toLowerCase()\n  .replace(/[^a-z0-9]+/g, '-')\n  .replace(/(^-|-$)/g, '');\n\nreturn [{\n  ...$json,\n  slug,\n  filename: `${new Date().toISOString().split('T')[0]}-${slug}.md`\n}];"
      },
